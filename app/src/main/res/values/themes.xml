<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Mygalleryapp" parent="Theme.AppCompat.DayNight.NoActionBar" />

    <!-- Тема для всплывающего экрана (Splash Screen) -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Цвет фона экрана (черный для AMOLED стиля) -->
        <item name="windowSplashScreenBackground">#000000</item>
        <!-- Скрываем иконку, используя прозрачный цвет -->
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <!-- Тема, которая будет применена после всплывающего экрана -->
        <item name="postSplashScreenTheme">@style/Theme.Mygalleryapp</item>
    </style>
</resources>
